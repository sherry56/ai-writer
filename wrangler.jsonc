{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-writer",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "7e36c9335137a259db23d1261a10dbbc",
  "workers_dev": true,
  "routes": [
    { "pattern": "writer.huibara.cn", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 300000 },
  "containers": [
    {
      "class_name": "AiWriterContainer",
      "scheduling_policy": "durable_object",
      "images": { "app": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AI_WRITER", "class_name": "AiWriterContainer" }
    ]
  },
  "exports": {
    "AiWriterContainer": { "type": "durable-object", "storage": "sqlite" }
  },
}

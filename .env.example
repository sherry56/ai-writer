# ===== LLM 模型 =====
# v0.4 起每个模型独立配置 provider/api_key/base_url。优先读 config/models.json
# (复制 config/models.json.example 来用)。
# 也可通过 MODELS_JSON 环境变量传整段 JSON：
#   {"default":"gpt-5.5","models":[{"value":"gpt-5.5","provider":"openai","api_key":"sk-xx","base_url":"https://..."}]}
MODELS_JSON=

# 单模型兜底（仅当未配置 models.json 也未设 MODELS_JSON 时使用,保持旧部署兼容）
LLM_PROVIDER=openai
WRITER_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ===== 会话 / 登录 =====
# 用于签名 cookie 的密钥。生产环境务必设一个随机长串(例：python -c "import secrets;print(secrets.token_urlsafe(48))")
# 不设的话每次重启会生成临时密钥，旧 session 全部失效。
SESSION_SECRET=

# 账户配置：优先读 config/users.json；也可直接用 USERS_JSON 环境变量(整段 JSON)
# {"users":{"admin":"明文或bcrypt哈希","alice":"..."}}
# 生成 bcrypt 哈希:python -m web.tools.hashpw <password>
USERS_JSON=

# 管理员账号：可修改公开示例；默认 sherry
ADMIN_USER=sherry

# ===== 路径 =====
DATABASE_URL=sqlite:///data/db.sqlite
STYLE_LIB_DIR=data/style_lib

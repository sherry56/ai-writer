# ===== LLM Provider =====
# 支持两种 provider：anthropic（官方 Claude）或 openai（任何 OpenAI 兼容接口）
# OpenAI 兼容包括：OpenAI 官方、DeepSeek、Moonshot Kimi、OpenRouter、智谱、本地 Ollama 等
LLM_PROVIDER=anthropic

# 写作模型（按 provider 改）：
#   anthropic 示例：claude-opus-4-7 / claude-sonnet-4-6 / claude-haiku-4-5-20251001
#   openai    示例：gpt-4o / deepseek-chat / moonshot-v1-32k / qwen-max
WRITER_MODEL=claude-opus-4-7

# ===== Anthropic (LLM_PROVIDER=anthropic 时生效) =====
ANTHROPIC_API_KEY=sk-ant-xxx

# ===== OpenAI 兼容 (LLM_PROVIDER=openai 时生效) =====
OPENAI_API_KEY=
# OpenAI 官方留空即可；用其它服务时填对应 base_url，例如：
#   DeepSeek:  https://api.deepseek.com/v1
#   Moonshot:  https://api.moonshot.cn/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:    http://localhost:11434/v1
OPENAI_BASE_URL=

# ===== 路径 =====
DATABASE_URL=sqlite:///data/db.sqlite
STYLE_LIB_DIR=data/style_lib
